# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514    # opcional, default sonnet 4
CLAUDE_MAX_TOKENS=2048                    # opcional

# ─── Meta Cloud API (número del bot) ─────────────────────────────────────────
META_PHONE_NUMBER_ID=          # ID del número en Meta Business
META_WHATSAPP_TOKEN=           # Token de acceso permanente
META_VERIFY_TOKEN=             # Token que tú eliges para verificar el webhook
META_APP_SECRET=               # App Secret de Meta (para validar firma de webhooks)
BOSS_PHONE=                    # Número del jefe en formato internacional, ej: 573001234567

# ─── OpenWA (número del jefe - lectura de chats) ─────────────────────────────
OPENWA_URL=http://openwa-api:2785/api
OPENWA_API_KEY=                # API key de tu instancia OpenWA
OPENWA_SESSION_ID=             # ID de la sesión del número del jefe en OpenWA
OPENWA_WEBHOOK_SECRET=         # Secret HMAC para validar webhooks de OpenWA

# ─── Bot ──────────────────────────────────────────────────────────────────────
BOT_NAME=Juanito               # Nombre con el que se menciona al bot en grupos
MAX_GROUPS_PER_CYCLE=10        # Máx grupos a resumir por ciclo

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/brain.sqlite

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PUBLIC_URL=                    # URL pública del VPS, ej: https://tudominio.com

# ─── Zona horaria (para recordatorios) ───────────────────────────────────────
TZ=America/Bogota
