# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6          # modelo a usar
CLAUDE_MAX_TOKENS=2048

# ─── WhatsApp (número del agente) ─────────────────────────────────────────────
AGENT_PHONE=+573001234567               # número de la SIM del bot (con código de país)
                                        # Solo necesario para el primer vinculado

# ─── Identidad ────────────────────────────────────────────────────────────────
BOSS_PHONE=573001234567                 # número del jefe (sin +, como lo manda WA)
BOT_NAME=Juanito                        # nombre con el que se menciona al bot en grupos

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/brain.sqlite
WA_SESSION_PATH=./data/wa-session       # sesión de Baileys (persiste entre reinicios)

# ─── Scheduler ────────────────────────────────────────────────────────────────
SUMMARY_CRON=0 */4 * * *               # cuándo resumir grupos (default: cada 4h)
SUMMARY_CYCLE_HOURS=4                  # ventana de mensajes a resumir
MAX_GROUPS_PER_CYCLE=10                # máx grupos por ciclo de resumen

# ─── QR web server (solo durante la vinculación) ──────────────────────────────
# Descomentar + habilitar el puerto en docker-compose.yml para ver el QR en el
# navegador. Comentar de nuevo una vez vinculado (no exponer en producción).
# QR_PORT=3001

# ─── Runtime ──────────────────────────────────────────────────────────────────
TZ=America/Bogota
NODE_ENV=production
