# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001  # modelo en DMs (jefe/admin). Default: Haiku
CLAUDE_GROUP_MODEL=                     # modelo en grupos. Vacío = usa CLAUDE_MODEL
CLAUDE_MAX_TOKENS=2048

# ─── WhatsApp (número del agente) ─────────────────────────────────────────────
AGENT_PHONE=+573001234567               # número de la SIM del bot (con código de país)
                                        # Solo necesario para el primer vinculado

# ─── Identidad ────────────────────────────────────────────────────────────────
BOSS_PHONE=573001234567                 # número del jefe (sin +, como lo manda WA)
# BOSS_LID=147313234280449@lid          # LID del jefe en WA multi-device — obtenerlo de los logs
                                        # al arrancar: "[Main] DM de LID del jefe: <lid>@lid".
                                        # Sin esto, cualquier @lid no resuelto se trata como jefe
                                        # (seguro, pero los closers no pueden hacer opt-in via DM).
BOT_NAME=Juanito                        # nombre con el que se menciona al bot en grupos
GROUP_AUTOLEAVE=log                     # anti-secuestro: 'log' solo registra, 'on' sale de grupos no autorizados
BOSS_NAME=                              # nombre del jefe (ej: Juan). Juanito lo usa para saludarlo por nombre.

# ─── Anti-ráfaga / anti-ban (envío en grupos) ─────────────────────────────────
# La cola de envío serializa TODO con un gap GLOBAL; además espacia los envíos al
# MISMO grupo para que el bot no parezca ametralladora. Defaults seguros.
# GROUP_DAILY_LIMIT=5                    # menciones máx por usuario/día en grupos (y DMs de desconocidos)
# WA_SEND_MIN_GAP_MS=1000               # gap global mínimo entre envíos
# WA_SEND_JITTER_MS=500                 # jitter sobre el gap global
# WA_SEND_PER_GROUP_GAP_MS=8000         # separación mínima entre 2 respuestas al MISMO grupo
# WA_SEND_PER_GROUP_JITTER_MS=2000      # jitter sobre el gap por grupo (→ ~8-10s)
# GROUP_REPLY_HOURLY_CAP=15             # tope de respuestas autónomas del bot por grupo/hora

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/brain.sqlite
WA_SESSION_PATH=./data/wa-session       # sesión de Baileys (persiste entre reinicios)

# ─── Scheduler ────────────────────────────────────────────────────────────────
SUMMARY_CRON=0 */4 * * *               # cuándo resumir grupos (default: cada 4h)
SUMMARY_CYCLE_HOURS=4                  # ventana de mensajes a resumir
MAX_GROUPS_PER_CYCLE=10                # máx grupos por ciclo de resumen

# ─── QR web server (solo durante la vinculación) ──────────────────────────────
# Descomentar + habilitar el puerto en docker-compose.yml para ver el QR en el
# navegador. Comentar de nuevo una vez vinculado (no exponer en producción).
# QR_PORT=3001

# ─── Calendly (recordatorios precall a closers) ───────────────────────────────
CALENDLY_TOKEN=                          # Personal Access Token (plan pago). NO commitear.
CALENDLY_DRY_RUN=true                    # true = no envía WhatsApp, solo loguea. Poner false para activar envío real.
CALENDLY_REQUIRE_OPTIN=true              # true = solo envía a closers que ya le escribieron a Juanito (anti-baneo). NO recomendado ponerlo en false.
# Defaults ya resueltos contra la cuenta real (grupo "Negociación" + 2 programas);
# solo descomentar si cambian:
# CALENDLY_GROUP_URI=https://api.calendly.com/groups/61f57776-40d4-4feb-bdbc-654f397ba0c6
# CALENDLY_EVENT_TYPES=https://api.calendly.com/event_types/56efc028-ee2f-46e8-852c-e50d45b15b83,https://api.calendly.com/event_types/f8d123ac-364b-47f9-a446-1316fdf37b08
CALENDLY_PUSH3_LEAD_MIN=25               # minutos antes de la llamada para el Push 3
# CALENDLY_POLL_CRON=*/5 * * * *         # cada cuánto descubre citas nuevas
# CALENDLY_PUSH1_CRON=0 19 * * *         # Push 1: 7:00pm (digest de mañana)
# CALENDLY_PUSH2_CRON=30 6 * * *         # Push 2: 6:30am (digest de hoy)
# CALENDLY_DELIVER_CRON=* * * * *        # cada cuánto entrega los Push 3 vencidos
# CALENDLY_MIN_GAP_MS=1200               # throttle propio (~50 req/min)
# Push 0 (§18.C): aviso de "nueva call HOY" cuando reservan un slot ya pasados los digests
# CALENDLY_PUSH0_ENABLED=true            # poner false para desactivar el aviso de nueva call
# CALENDLY_PUSH0_RECENT_MIN=10           # qué tan reciente (min) debe ser el booking para avisar

# ─── Reporte diario de leads desde Google Sheets (§18.B) ──────────────────────
# Juanito publica a las 20:00 un conteo + desglose de las postulaciones que llegaron
# al Sheet en la ventana [ayer 20:00, hoy 20:00). El código de parse/agregación es
# PURO (src/sheets/); la lectura real (client.js) necesita un service account.
# SHEETS_REPORT_GROUP=                     # group_id de "Ventas EstadoX" (resolver con listGroups())
# GOOGLE_SA_KEY=                           # JSON del service account (o path al archivo montado). NO commitear.
# SHEETS_LEADS_ID=1pg3cP9w9ag7Re8QF5ZM8S2ktNwMRZDCihE7UYJmtlV4   # ID del Sheet (default en código)
# SHEETS_LEADS_TAB=IA para abogados _ EstadoX                     # pestaña a leer (default en código)
# SHEETS_REPORT_CRON=0 20 * * *            # cuándo publicar el reporte (default: 8:00pm)
# SHEETS_SRC_AHEAD_HOURS=3                  # "Submitted At" viene en GMT-2 (3h adelante de Bogotá); se resta. Cambiar solo si el Form cambia de zona.

# ─── Reporte diario de MÉTRICAS de desempeño por DM (§18.N) ───────────────────
# Lee una pestaña con las métricas YA CALCULADAS (otro spreadsheet — el dueño debe
# compartirlo con el email del service account) y la envía por DM a una lista de
# personas a las 20:00. Reúsa GOOGLE_SA_KEY. Se autodesactiva si falta algo.
# SHEETS_METRICS_ID=                       # ID del spreadsheet de métricas (distinto al de leads)
# SHEETS_METRICS_TAB=                       # nombre EXACTO de la pestaña de métricas
# SHEETS_METRICS_RECIPIENTS=boss,158025419608301@lid   # CSV teléfonos/JIDs/LIDs. "boss" = el jefe; el LID es Sebastián Rodríguez
# SHEETS_METRICS_CRON=0 20 * * *           # cuándo enviar las métricas (default: 8:00pm)

# ─── Runtime ──────────────────────────────────────────────────────────────────
TZ=America/Bogota
NODE_ENV=production
