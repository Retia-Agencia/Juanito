# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6          # modelo a usar
CLAUDE_MAX_TOKENS=2048

# ─── WhatsApp (número del agente) ─────────────────────────────────────────────
AGENT_PHONE=+573001234567               # número de la SIM del bot (con código de país)
                                        # Solo necesario para el primer vinculado

# ─── Identidad ────────────────────────────────────────────────────────────────
BOSS_PHONE=573001234567                 # número del jefe (sin +, como lo manda WA)
# BOSS_LID=147313234280449@lid          # LID del jefe en WA multi-device — obtenerlo de los logs
                                        # al arrancar: "[Main] DM de LID del jefe: <lid>@lid".
                                        # Sin esto, cualquier @lid no resuelto se trata como jefe
                                        # (seguro, pero los closers no pueden hacer opt-in via DM).
BOT_NAME=Juanito                        # nombre con el que se menciona al bot en grupos
BOSS_NAME=                              # nombre del jefe (ej: Juan). Juanito lo usa para saludarlo por nombre.

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/brain.sqlite
WA_SESSION_PATH=./data/wa-session       # sesión de Baileys (persiste entre reinicios)

# ─── Scheduler ────────────────────────────────────────────────────────────────
SUMMARY_CRON=0 */4 * * *               # cuándo resumir grupos (default: cada 4h)
SUMMARY_CYCLE_HOURS=4                  # ventana de mensajes a resumir
MAX_GROUPS_PER_CYCLE=10                # máx grupos por ciclo de resumen

# ─── QR web server (solo durante la vinculación) ──────────────────────────────
# Descomentar + habilitar el puerto en docker-compose.yml para ver el QR en el
# navegador. Comentar de nuevo una vez vinculado (no exponer en producción).
# QR_PORT=3001

# ─── Calendly (recordatorios precall a closers) ───────────────────────────────
CALENDLY_TOKEN=                          # Personal Access Token (plan pago). NO commitear.
CALENDLY_DRY_RUN=true                    # true = no envía WhatsApp, solo loguea. Poner false para activar envío real.
CALENDLY_REQUIRE_OPTIN=true              # true = solo envía a closers que ya le escribieron a Juanito (anti-baneo). NO recomendado ponerlo en false.
# Defaults ya resueltos contra la cuenta real (grupo "Negociación" + 2 programas);
# solo descomentar si cambian:
# CALENDLY_GROUP_URI=https://api.calendly.com/groups/61f57776-40d4-4feb-bdbc-654f397ba0c6
# CALENDLY_EVENT_TYPES=https://api.calendly.com/event_types/56efc028-ee2f-46e8-852c-e50d45b15b83,https://api.calendly.com/event_types/f8d123ac-364b-47f9-a446-1316fdf37b08
CALENDLY_PUSH3_LEAD_MIN=25               # minutos antes de la llamada para el Push 3
# CALENDLY_POLL_CRON=*/5 * * * *         # cada cuánto descubre citas nuevas
# CALENDLY_PUSH1_CRON=0 19 * * *         # Push 1: 7:00pm (digest de mañana)
# CALENDLY_PUSH2_CRON=30 6 * * *         # Push 2: 6:30am (digest de hoy)
# CALENDLY_DELIVER_CRON=* * * * *        # cada cuánto entrega los Push 3 vencidos
# CALENDLY_MIN_GAP_MS=1200               # throttle propio (~50 req/min)

# ─── Runtime ──────────────────────────────────────────────────────────────────
TZ=America/Bogota
NODE_ENV=production
