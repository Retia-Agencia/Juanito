# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001  # modelo base en DMs de rol desconocido. Default: Haiku
CLAUDE_GROUP_MODEL=                     # modelo del chatbot de grupo. Vacío = usa CLAUDE_MODEL
CLAUDE_BOSS_MODEL=                      # modelo del DM del jefe. Vacío = usa CLAUDE_MODEL
# Modelo del DM de un CLOSER (§18.BE). Sus tres tools ESCRIBEN (registrar/corregir/borrar
# setteos), así que confundir "toqué a Juan" con "borrá el de Juan" le crea un lead fantasma
# que después hay que limpiar a mano. Es chat de bajo volumen: unos pocos mensajes al día por
# persona. Sugerido: un Sonnet. Vacío = usa CLAUDE_MODEL (comportamiento de antes).
CLAUDE_CLOSER_MODEL=
# Modelo de RAZONAMIENTO para jefe/admin (su DM + cuando mencionan en grupo). Un modelo más
# capaz distingue mejor ORDEN (ejecutar acción) vs PREGUNTA normal (solo responder).
# Sugerido: un Sonnet. Vacío = usa CLAUDE_BOSS_MODEL (y este, a su vez, CLAUDE_MODEL).
CLAUDE_REASONING_MODEL=                 # ej: claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
# Extended/adaptive thinking SOLO en el camino de razonamiento (jefe/admin). APAGADO por
# default → comportamiento idéntico al actual. Prender con CLAUDE_THINKING=on (sin redeploy de
# código). Requiere que CLAUDE_REASONING_MODEL sea un modelo 4.6+ (Sonnet 4.6, Opus 4.6/4.7/4.8,
# Fable 5); con Haiku 4.5 / Sonnet 4.5 el flag se ignora. Sube el costo de ese camino (razonar
# factura como tokens de salida); ver el log "[Claude][costo]" por interacción para medirlo.
CLAUDE_THINKING=off                     # on | off (default off)
CLAUDE_THINKING_EFFORT=medium           # low | medium | high (profundidad del razonamiento)
CLAUDE_REASONING_MAX_TOKENS=8000        # headroom de salida cuando thinking está on (2048 trunca)
# Contexto de grupo POR TIEMPO con tope duro de mensajes (palanca de costo en grupos con
# alto flujo): se cargan los turnos de los últimos N minutos, hasta un máximo de mensajes.
# CLAUDE_GROUP_HISTORY_MINUTES=30        # ventana de tiempo del contexto de grupo (default 30 min)
# CLAUDE_GROUP_HISTORY=100               # tope MÁXIMO de mensajes del contexto de grupo (default 100)

# ─── WhatsApp (número del agente) ─────────────────────────────────────────────
AGENT_PHONE=+573001234567               # número de la SIM del bot (con código de país)
                                        # Solo necesario para el primer vinculado

# ─── Identidad ────────────────────────────────────────────────────────────────
BOSS_PHONE=573001234567                 # número del jefe (sin +, como lo manda WA)
# BOSS_LID=147313234280449@lid          # LID del jefe en WA multi-device — obtenerlo de los logs
                                        # al arrancar: "[Main] DM de LID del jefe: <lid>@lid".
                                        # Sin esto, cualquier @lid no resuelto se trata como jefe
                                        # (seguro, pero los closers no pueden hacer opt-in via DM).
                                        # IMPORTANTE: las ÓRDENES DEL JEFE DESDE UN GRUPO exigen
                                        # BOSS_LID o ADMIN_LID configurados de verdad — la verificación
                                        # estricta NO usa el fallback "cualquier @lid = jefe" (en un
                                        # grupo todos llegan como @lid). Sin ellos, esa función no se activa.
# ADMIN_LID=129446371655733@lid,573174428980
#                                       # equipo dev (máximo privilegio), separado por comas.
#                                       # Cada entrada puede ser un LID (`<num>@lid`) O un TELÉFONO
#                                       # (dígitos, con o sin + y sin sufijo). CARGAR LAS DOS del
#                                       # mismo admin: un DM suyo llega como @lid o como phone-JID
#                                       # según haya alcanzado a llenarse el lidMap (contacts.upsert)
#                                       # de whatsapp/index.js, que traduce LID → teléfono. Con solo
#                                       # una de las dos, el admin cae en 'unknown' de a ratos.
#                                       # El match por teléfono es por igualdad EXACTA de dígitos
#                                       # (no por sufijo como BOSS_PHONE): es máximo privilegio.
BOT_NAME=Juanito                        # nombre con el que se menciona al bot en grupos
GROUP_AUTOLEAVE=log                     # anti-secuestro: 'log' solo registra, 'on' sale de grupos no autorizados
BOSS_NAME=                              # nombre del jefe (ej: Juan). Juanito lo usa para saludarlo por nombre.

# ─── Anti-ráfaga / anti-ban (envío en grupos) ─────────────────────────────────
# La cola de envío serializa TODO con un gap GLOBAL; además espacia los envíos al
# MISMO grupo para que el bot no parezca ametralladora. Defaults seguros.
# GROUP_DAILY_LIMIT=5                    # menciones máx por usuario/día en grupos (y DMs de desconocidos)
# WA_SEND_MIN_GAP_MS=1000               # gap global mínimo entre envíos
# WA_SEND_JITTER_MS=500                 # jitter sobre el gap global
# WA_SEND_PER_GROUP_GAP_MS=8000         # separación mínima entre 2 respuestas al MISMO grupo
# WA_SEND_PER_GROUP_JITTER_MS=2000      # jitter sobre el gap por grupo (→ ~8-10s)

# Reapertura del socket EN CALIENTE ante un cierre de CABLE (428 connectionClosed / 408
# timedOut) en vez de matar el proceso (§18.BN). Sin esto, cada caída rutinaria del socket
# cuesta un proceso nuevo + una reconexión completa de Baileys + la cola de envío en memoria.
#
# ⚠️ APAGADO por default y no es cortesía: toca el camino que provocó el softban de julio.
# Prenderlo mirando; señal de abortar inmediata = cualquier 405/403 en el log después de
# prenderlo. Rollback: WA_HOT_REOPEN=false + `docker compose up -d` (sin --build).
#
# Solo 428 y 408 reabren (allowlist). Todo lo demás —405, 403, 440 connectionReplaced, y
# cualquier código nuevo— sigue saliendo con exit(1) hacia el backoff de entrypoint.sh.
# Tope de 3 reaperturas con esperas de 5s/15s/45s; se reinicia tras 10 min de conexión sana.
# WA_HOT_REOPEN=false
# WA_HEALTHY_MS=600000                  # solo para pruebas: bajar el umbral de "conexión sana"
# GROUP_REPLY_HOURLY_CAP=15             # tope de respuestas autónomas del bot por grupo/hora

# ─── Aprobaciones (respuestas que pasan por el jefe) ──────────────────────────
# Solo aplica en grupos con require_approval=ON y en DMs con dm_approval=ON.
# Grupo al que se mandan las solicitudes de aprobación (borradores §18.F + respuestas §18.O/J).
# Sin esto, van al DM del jefe (comportamiento previo). Puede ser el group_id (…@g.us, recomendado)
# o el NOMBRE del grupo (se resuelve en runtime). El jefe/admin aprueban AHÍ sin mención.
# APPROVALS_GROUP=                      # ej: 120363...@g.us  ó  "Aprobaciones Juanito"
# REPLY_APPROVAL_TTL_MIN=30             # min sin decisión antes de "rescatar" la pendiente
# REPLY_EXPIRY_NOTICE=                  # aviso al remitente cuando vence sin decisión (default amable)
# Ventana de DESCANSO / sueño: dentro de ella Juanito NO molesta al jefe con solicitudes de
# aprobación (quedan en cola y se informan en un digest al volver el horario laboral); al
# remitente se le avisa, amable y una vez al día, que está fuera de horario. HH:MM en la TZ
# del bot. Si falta alguna, NO hay ventana (comportamiento de siempre). Maneja cruce de medianoche.
# QUIET_HOURS_START=21:00               # inicio del descanso (9pm)
# QUIET_HOURS_END=07:00                 # fin del descanso (7am)
# QUIET_HOURS_NOTICE=                   # texto del aviso fuera de horario (default amable)

# ─── Mensajes a terceros (tool schedule_outreach, solo por orden del jefe) ────
# Cuando el jefe ordena "escríbele a X cada N min/…", Juanito redacta y envía a esa persona.
# Piso anti-spam del intervalo: no le escribe a un tercero más seguido que esto (minutos).
# Los recurrentes por intervalo se pausan en quiet hours y, sin until/count, paran al iniciar el descanso.
# OUTREACH_MIN_INTERVAL_MIN=5           # intervalo mínimo permitido entre mensajes a un tercero

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/brain.sqlite
WA_SESSION_PATH=./data/wa-session       # sesión de Baileys (persiste entre reinicios)

# ─── Scheduler ────────────────────────────────────────────────────────────────
SUMMARY_CRON=0 */4 * * *               # cuándo resumir grupos (default: cada 4h)
SUMMARY_CYCLE_HOURS=4                  # ventana de mensajes a resumir
MAX_GROUPS_PER_CYCLE=10                # máx grupos por ciclo de resumen

# Extracción de contexto de negocio (Fase 2B): propone hechos del negocio desde los resúmenes
# de grupos (status='proposed' → admin confirma con /negocio ok). Se autodesactiva sin API key.
BIZ_EXTRACT_CRON=0 3 * * *             # cuándo extraer (default: diario 3am)
BIZ_EXTRACT_SUMMARIES=20              # cuántos resúmenes recientes leer por pasada

# ─── QR web server (solo durante la vinculación) ──────────────────────────────
# Descomentar + habilitar el puerto en docker-compose.yml para ver el QR en el
# navegador. Comentar de nuevo una vez vinculado (no exponer en producción).
# QR_PORT=3001

# ─── Calendly (recordatorios precall a closers) ───────────────────────────────
# MULTI-CUENTA: Juanito puede atender varias cuentas de Calendly (una por empresa/agencia).
# El registro vive en src/calendly/accounts.js — ahí está el tuple de cada cuenta (token,
# organización, event_types, dry-run, push4, hubspot). Estas env son las de la cuenta '30x'
# (30X + EstadoX). Cada cuenta nueva trae SUS PROPIAS vars, declaradas en su entrada del
# registro; sin su token, la cuenta se autodesactiva y es como si no existiera.
CALENDLY_TOKEN=                          # Personal Access Token de la cuenta 30x (plan pago). NO commitear.
CALENDLY_DRY_RUN=true                    # true = no envía WhatsApp, solo loguea. Poner false para activar envío real. SOLO afecta a la cuenta '30x'.
CALENDLY_REQUIRE_OPTIN=true              # true = solo envía a closers que ya le escribieron a Juanito (anti-baneo). NO recomendado ponerlo en false. Aplica a TODAS las cuentas.
# ── Agenda diaria a la admin de la marca (7am) ────────────────────────────────────────────
# Pedido 2026-08-25: cuántas llamadas tiene HOY cada closer de IA para Abogados, por DM a quien
# supervisa (Mariana). NO es un digest de closer: no lleva nombres ni teléfonos de leads.
# Se autodesactiva sin ADMIN_AGENDA_DM (el cron ni se registra).
ADMIN_AGENDA_DM=                          # JIDs CSV. Mismo requisito que SHEETS_REPORT_DM: el JID desde el que la persona LE ESCRIBIÓ a Juanito, o no hay hilo y no se entrega (anti-ban).
# ADMIN_AGENDA_CRON=0 7 * * *             # cuándo se manda (default: 7:00am hora de TZ).
# ADMIN_AGENDA_CONNECTION=estadox         # de qué conexión de Calendly se cuentan las calls y de qué roster salen los closers.
# ── Cuenta EstadoX (Calendly propio de la marca, programa "IA para Abogados") ──────────────
# EstadoX vendía desde el Calendly de 30X hasta el 2026-07-24, cuando abrió el suyo. Nadie movió la
# config → Juanito siguió mirando el event_type viejo y el programa estuvo UN MES sin pushes, sin
# un solo error en los logs (el poll no distingue "no hubo citas" de "Calendly equivocado").
# Org URI y event_type están DERIVADOS y hardcodeados en src/calendly/accounts.js y programs.js →
# solo hace falta el token acá. Sin él la conexión se autodesactiva (no entra a activeAccounts).
CALENDLY_TOKEN_ESTADOX=                   # Personal Access Token del Calendly de EstadoX (comunidad@estadox.com). NO commitear.
# CALENDLY_ORG_URI_ESTADOX=               # Override opcional del org URI (ya hardcodeado en accounts.js).
CALENDLY_DRY_RUN_ESTADOX=true             # true = EstadoX solo loguea ([DRY-RUN:estadox]). Poner false SOLO tras validar un ciclo completo. No afecta a 30X ni a Retia.
# ── Cuenta ComunicArte (conexión #4, programa "Método Comunicarte") ───────────────────────
# Calendly PROPIO de la marca (info@eventoscomunicarte.com). Org URI y event_type ya están
# DERIVADOS y hardcodeados en src/calendly/accounts.js y programs.js → solo hace falta el token.
# Sin él la conexión se autodesactiva (no entra a activeAccounts) → inerte.
# ⚠️ Al 2026-08-25 sus reservas llegan SIN TELÉFONO del lead ⇒ los pushes salen "(mándalo
#    manual)", sin link wa.me. Es config del lado de Calendly; ver el comentario en programs.js.
CALENDLY_TOKEN_COMUNICARTE=               # Personal Access Token del Calendly de ComunicArte. NO commitear.
# CALENDLY_ORG_URI_COMUNICARTE=           # Override opcional del org URI (ya hardcodeado en accounts.js).
CALENDLY_DRY_RUN_COMUNICARTE=true         # true = ComunicArte solo loguea ([DRY-RUN:comunicarte]). Poner false SOLO tras validar un ciclo completo. No afecta a las otras conexiones.
# ── Espejo de dev (§18.BM) ────────────────────────────────────────────────────────────────
# Copia a un JID de DEV de todo lo que sale (o NO sale) hacia los closers de las conexiones
# listadas, con el resultado en el encabezado ('sent', 'dry-run', 'skipped-optin', …). Sirve para
# acompañar el arranque de una conexión nueva sin depender de que un closer reporte lo que no ve.
# Respeta la pausa GLOBAL (`/calendly off`) — el botón de pánico también calla el espejo.
# Ambas vacías = apagado. Quitar el JID lo apaga sin tocar código.
CALENDLY_DEV_MIRROR_JID=                  # JID del dev (ej: 147313234280449@lid). Tiene que ser un hilo YA abierto con Juanito.
CALENDLY_DEV_MIRROR_CONNECTIONS=          # CSV de conexiones a espejar (ej: comunicarte,retia). Vacío = ninguna.
# ── Cuenta Retia (agencia #2, programa "De Cero a Tactical Investor") ──────────────────────
# Es UN Calendly POR PROGRAMA (Retia no tiene Calendly unificado; ver §18.AH). Org URI y event_type
# ya están DERIVADOS y hardcodeados en src/calendly/accounts.js → solo hace falta el token acá.
# Sin CALENDLY_TOKEN_RETIA la cuenta se autodesactiva (no entra a activeAccounts) → inerte.
CALENDLY_TOKEN_RETIA=                     # Personal Access Token del Calendly de Retia. NO commitear. Sin él, Retia inerte.
# CALENDLY_ORG_URI_RETIA=                 # Override opcional del org URI (ya hardcodeado en accounts.js).
CALENDLY_DRY_RUN_RETIA=true               # true = Retia solo loguea ([DRY-RUN:retia]). Poner false SOLO tras validar un ciclo completo. No afecta a 30X.
# Push 5 (§18.AP) — recordatorio de llenar los Google Sheets, N min después de que TERMINA la call.
# QUIÉN lo recibe se decide en accounts.js (la conexión que declara `sheets`; hoy solo retia), no acá:
# este flag es el apagado de emergencia. No afecta a 30X, que no declara sheets.
# CALENDLY_SHEET_PUSH=true                # false = ninguna cuenta agenda el Push 5 (default: true).
# CALENDLY_SHEET_DELAY_MIN=10             # minutos DESPUÉS del fin real de la call (ev.end_time).
# Defaults ya resueltos contra la cuenta real (organización + 6 programas: Second Brain,
# IA para Abogados, LinkedIn Sales, AI for Developers, Operaciones Escalables con AI e
# Instagram & TikTok); solo descomentar si cambian.
# El query es a nivel ORGANIZACIÓN (los closers de LinkedIn Sales no están en ningún grupo).
# ⚠️ Si seteás CALENDLY_EVENT_TYPES, REEMPLAZA la lista entera del código y NO distingue
#    cuentas — un programa que no esté acá deja de recibir pushes. Sirve para acotar una
#    prueba, no para sumar una cuenta. Dejarlo sin setear es lo normal (usa el registro).
# CALENDLY_ORG_URI=https://api.calendly.com/organizations/9ac5ab82-0c41-43c8-bede-cc9787043b28
# CALENDLY_EVENT_TYPES=<et_second_brain>,<et_abogados>,<et_linkedin>,<et_developers>,<et_operaciones>,<et_instagram>
CALENDLY_PUSH3_LEAD_MIN=25               # minutos antes de la llamada para el Push 3
# CALENDLY_POLL_CRON=*/5 * * * *         # cada cuánto descubre citas nuevas
# CALENDLY_PUSH1_CRON=0 19 * * *         # Push 1: 7:00pm (digest de mañana)
# CALENDLY_PUSH2_CRON=30 6 * * *         # Push 2: 6:30am (digest de hoy)
# Auditoría de skips: avisa al admin (ADMIN_LID) cuando un closer acumula pushes NO
# entregados por causa accionable (sin opt-in, sin hilo, vencidos sin salir) en 24h.
# CALENDLY_SKIP_AUDIT_CRON=15 * * * *    # cada hora, al minuto 15
# CALENDLY_SKIP_ALERT_MIN=2              # umbral por closer (1 alertaría por casos aislados)
# CALENDLY_DELIVER_CRON=* * * * *        # cada cuánto entrega los Push 3 vencidos
# CALENDLY_MIN_GAP_MS=1200               # throttle propio (~50 req/min)
# Push 0 (§18.C): aviso de "nueva call HOY" cuando reservan un slot ya pasados los digests
# CALENDLY_PUSH0_ENABLED=true            # poner false para desactivar el aviso de nueva call
# CALENDLY_PUSH0_RECENT_MIN=10           # qué tan reciente (min) debe ser el booking para avisar

# Reagendas (§18.AC): con "3 · Reagendó", Juanito pide la fecha nueva y agenda la call por su
# cuenta (Push 3 + Push 4 con un event_uuid sintético 'manual:…'), venga o no de Calendly. Es
# lo que evita el doble conteo y lo que hace visibles las reagendas hechas por otro link.
CALENDLY_RESCHEDULE_ENABLED=false         # rollout acotado: usar junto con CALENDLY_PUSH4_CLOSERS
# CALENDLY_RESCHEDULE_PROMPT_CRON=0 9 * * *   # insistencia diaria por las reagendas sin fecha
# CALENDLY_RESCHEDULE_MAX_ASKED=3        # cuántas veces se pide la fecha antes de cerrarla sin ella
# CALENDLY_RESCHEDULE_MAX_CHAIN=3        # tope de reagendas encadenadas del mismo lead
# CALENDLY_RESCHEDULE_AI=true            # false = solo el parser regex, sin fallback a Claude
# CALENDLY_RESCHEDULE_MODEL=             # default: CLAUDE_MODEL (Haiku). Solo se usa si el regex falla.
# CALENDLY_RESCHEDULE_AI_TIMEOUT_MS=8000
# OUTCOME_REPLY_WINDOW_MIN=120           # cuánto sigue "caliente" un outcome a medio flujo (§18.AC)

# ─── Reporte diario de leads desde Google Sheets (§18.B) ──────────────────────
# Juanito publica a las 20:00 un conteo + desglose de las postulaciones que llegaron
# al Sheet en la ventana [ayer 20:00, hoy 20:00). El código de parse/agregación es
# PURO (src/sheets/); la lectura real (client.js) necesita un service account.
# SHEETS_REPORT_GROUP=                     # group_id de "Ventas EstadoX" (resolver con listGroups())
# GOOGLE_SA_KEY=                           # JSON del service account (o path al archivo montado). NO commitear.
# SHEETS_LEADS_ID=1pg3cP9w9ag7Re8QF5ZM8S2ktNwMRZDCihE7UYJmtlV4   # ID del Sheet (default en código)
# SHEETS_LEADS_TAB=IA para abogados _ EstadoX                     # pestaña a leer (default en código)
# SHEETS_REPORT_CRON=0 20 * * *            # cuándo publicar el reporte (default: 8:00pm)
# SHEETS_SRC_AHEAD_HOURS=3                  # "Submitted At" viene en GMT-2 (3h adelante de Bogotá); se resta. Cambiar solo si el Form cambia de zona.
# STRIPE_API_KEY=                          # restricted key SOLO LECTURA (rk_live_…) con permiso "read" sobre PaymentIntents, Checkout Sessions y **Charges** — NUNCA la secret key (sk_…). Con key, el "pagaron" del reporte y las comparativas semanales salen de pagos cobrados de verdad; el permiso sobre Charges además habilita el bloque de VENTA NETA (mes a la fecha vs. el mismo tramo del mes anterior), que va SOLO por DM. Sin ese permiso el bloque se omite y el resto del reporte sale igual. NO commitear.
# Estudiantes confirmados por cohorte → línea "🎓 <label>: N confirmados" por cada una.
# Cuenta filas con nombre (columna A) del tab. Sin config, la línea NO aparece.
# Desde 2026-08-12 son VARIAS: mientras la cohorte en curso se dicta, la siguiente ya se
# está vendiendo. Lista `pestaña::rótulo` separada por comas — rotar es agregar una y
# sacar la más vieja, sin tocar código.
# SHEETS_COHORTS=Estudiantes Oficiales cohort Agosto::Cohorte 3 (Agosto),Estudiantes Oficiales cohort Septiembre::Cohorte 4 (Septiembre)
# Config LEGACY de UNA cohorte. Se sigue leyendo si SHEETS_COHORTS está vacía (así el VPS
# no se queda sin la línea entre el deploy y el cambio de config). Preferir SHEETS_COHORTS.
# SHEETS_COHORT_TAB=Estudiantes Oficiales cohort Agosto   # nombre EXACTO de la pestaña de la cohorte en el mismo Sheet de leads
# SHEETS_COHORT_LABEL=Cohorte 3 (Agosto)                  # rótulo que se muestra en el reporte

# ─── Notificaciones a la admin de EstadoX (§18.AD) ────────────────────────────
# Reporte diario por DM + aviso de pago apenas Stripe lo confirma. Los destinatarios son
# JIDs de WhatsApp (CSV), NO números sueltos: debe ser el JID desde el que la persona LE
# ESCRIBIÓ a Juanito (se lo dice /whoami). Sin hilo previo NO se entrega — Juanito nunca
# escribe en frío (es el patrón que provocó el softban anterior).
# SHEETS_REPORT_DM=                        # ej: 573001112233@s.whatsapp.net — recibe el reporte de las 8pm por DM
#
# ── Reporte del JEFE (Dani): scorecard consolidado de TODOS los programas + closers desde
#    call_outcomes (§18.AH). El comando /reportejefe funciona SIEMPRE (jefe/admin, on-demand).
#    El DM DIARIO está APAGADO por default: requiere prender el flag Y dar destinatarios.
# BOSS_REPORT_ENABLED=false                # true = manda el DM diario (el comando no depende de esto)
# BOSS_REPORT_DM=                          # CSV de JIDs (Dani). Mismo requisito de hilo previo que cualquier DM (anti-ban)
# BOSS_REPORT_CRON=30 20 * * *             # default 20:30 Bogotá, tras las calls del día
#
# ── Setteo (backlog): conteo de setteos por closer = leads TOCADOS sin cita agendada, desde
#    HubSpot en vivo (read-only). Independiente de los leads de call (esos los mide Push 4).
#    /setteos on-demand corre SIEMPRE (jefe/admin). El anexo al reporte del jefe está APAGADO.
# SETTEO_REPORT_ENABLED=false              # true = anexa el bloque de setteo al reporte del jefe (/setteos NO depende de esto)
# SETTEO_REPORT_CLOSERS=                   # CSV de emails del scope. Default = CALENDLY_PUSH4_CLOSERS (scope del nudge)
#
# ── Setteo REPORTADO por el closer (§18.AZ): él se lo cuenta a Juanito por WhatsApp (texto
#    libre o /nuevosetteo), se guarda en SQLite y se cruza con HubSpot (read-only — Juanito
#    NUNCA escribe allá). Le da al closer /missetteos con TRES cifras: lo que reportó, lo que
#    figura registrado en el CRM y su cuota por horas libres. La brecha entre las dos primeras
#    es la señal nueva. Con SETTEO_CAPTURE_ENABLED=false un closer ve EXACTAMENTE lo de antes.
# SETTEO_CAPTURE_ENABLED=false             # true = captura + /missetteos + contexto agéntico del closer
# SETTEO_CAPTURE_CLOSERS=                  # CSV del piloto. Default: SETTEO_REPORT_CLOSERS → CALENDLY_PUSH4_CLOSERS
# SETTEO_AI_FALLBACK=true                  # false = solo el parser determinista (apaga la IA sin tumbar la captura)
# SETTEO_AI_MODEL=claude-haiku-4-5-20251001 # modelo del fallback (barato: 1 llamada, 500 tokens máx)
# SETTEO_AI_TIMEOUT_MS=8000                # si la API tarda más, se repregunta en vez de dejar colgado al closer
# SETTEO_CUOTA_POR_HORA=15                 # leads por HORA LIBRE (Protocolo Máquina de Ventas, 2026-06-10)
# SETTEO_JORNADA_INICIO=8                  # hora local de apertura de la jornada
# SETTEO_JORNADA_FIN=17                    # hora local de cierre → jornada = 9h por default
# SETTEO_MINUTOS_POR_CALL=60               # cuánto ocupa una call al calcular las horas libres
# CLOSER_DAILY_LIMIT=60                    # tope anti-ráfaga de mensajes/día por closer (freno de envío, no un permiso)
#
# ── Identidad de PRUEBA para el smoke del setteo (§18.BB). Agrega un closer DESECHABLE al
#    roster (src/calendly/closers.js): el smoke necesita que una persona real le escriba a
#    Juanito, porque el rol sale del JID de quien manda el mensaje. Apagarla no requiere deploy.
#    ⚠️ No basta con prenderla: si el LID de ese teléfono está en ADMIN_LID, roleOf() lo resuelve
#    como admin ANTES de llegar a la rama de closer y el smoke no prueba nada. Sacarlo mientras dure.
#    ⚠️ Un closer de mentira no ejercita el cruce con HubSpot (su email no es owner de nada → la
#    cifra sale 0 y todo aparece con ⚠️) ni la cuota (sin calls, la jornada entera sale libre).
# TEST_CLOSER_ENABLED=false
#
# ── 3 reportes diarios por DM (§18.AL): agenda 7am · progreso 12pm · cierre 9pm.
#    Todos salen de call_outcomes (misma fuente que el reporte del jefe). El de las 7am es
#    la AGENDA del día (calls agendadas hoy por closer/programa); los otros dos son el
#    scorecard consolidado, a distinta hora. APAGADO por default: requiere flag + destinatarios.
#    El JID debe ser el @lid del hilo desde el que la persona LE ESCRIBIÓ a Juanito (anti-ban).
# DAILY_REPORTS_ENABLED=false              # true = arranca los 3 jobs. APAGADO en prod desde el
#                                          # 2026-08-04 por orden del jefe (§18.AL). El log dice
#                                          # "DESACTIVADOS" y eso es INTENCIONAL, no el bug de julio.
# DAILY_REPORTS_DM=                        # CSV de JIDs (@lid). Prueba actual: el número del jefe (+573174428980)
# DAILY_REPORT_AM_CRON=0 7 * * *           # agenda del día (default 07:00 Bogotá)
# DAILY_REPORT_MID_CRON=0 12 * * *         # progreso (default 12:00)
# DAILY_REPORT_PM_CRON=0 21 * * *          # cierre (default 21:00)
# SHEETS_REPORT_ESTADOX_DM=                # ALIAS de SHEETS_REPORT_DM desde 2026-07-17: reciben EL MISMO reporte estándar (ya no el de 5 métricas). Se conserva para no romper la config del VPS; se une y deduplica con SHEETS_REPORT_DM. El JID debe ser aquel desde el que la persona LE ESCRIBIÓ a Juanito (/whoami se lo dice): sin hilo previo no se entrega (anti-ban).
# La publicación del reporte AL GRUPO "Ventas EstadoX" está apagada desde el 2026-07-08
# (pedido de Dani). SHEETS_REPORT_GROUP sigue configurado en el VPS, así que el apagado
# depende de este flag y no de que la var esté vacía. Ponerlo en true la reactiva.
# SHEETS_REPORT_GROUP_ENABLED=false
# STRIPE_SELF_CHECKOUT_PLINK=              # Payment Link (plink_…, NO la URL buy.stripe.com) del self-checkout de EstadoX. Con él, "pagos self-checkout" del reporte admin se atribuye por link en vez del tag manual del Sheet. Requiere que la rk_ tenga permiso "read" sobre Checkout Sessions además de PaymentIntents. Sin él, ese conteo sigue saliendo del tag.
# STRIPE_ALERT_JIDS=                       # quién recibe el aviso de pago (CSV de JIDs)
# STRIPE_ALERT_CRON=*/5 * * * *            # cada cuánto se le pregunta a Stripe
# STRIPE_ALERT_LOOKBACK_MIN=120            # ventana que mira cada poll (el dedup evita repetidos)

# ─── Reporte diario de MÉTRICAS de desempeño por DM (§18.N) ───────────────────
# Lee una pestaña con las métricas YA CALCULADAS (otro spreadsheet — el dueño debe
# compartirlo con el email del service account) y la envía por DM a una lista de
# personas a las 20:00. Reúsa GOOGLE_SA_KEY. Se autodesactiva si falta algo.
# Compartir el spreadsheet (Lector) con el service account: juanito-lector-sheets@juanito-sheets.iam.gserviceaccount.com
# SHEETS_METRICS_ID=1lipje1RTD-1VkW7uQnCUPOE32nrtlMt4NLYQD6i1mU4   # spreadsheet de métricas (distinto al de leads)
# SHEETS_METRICS_TAB=Resumen Diario         # pestaña diaria (show rate por closer, filtra Fecha Call = hoy)
# Cada sección del reporte va a un GRUPO distinto (ya no por DM). Juanito debe ser
# miembro de los grupos (y estar autorizado / haber un boss-admin para no auto-salir).
# SHEETS_METRICS_30X_GROUP=Closers Second Brain         # sección "AI SECOND BRAIN" (antes 30X) → este grupo
# SHEETS_METRICS_ESTADOX_GROUP=Closers IA para Abogados # sección "ESTADOX" → este grupo
# SHEETS_METRICS_LINKEDIN_GROUP=Closers LinkedIn Sales  # sección "LINKEDIN SALES" → este grupo (existe; verificar que Juanito sea miembro)
# SHEETS_METRICS_CRON=0 22 * * *           # cuándo enviar las métricas (default: 10:00pm)

# ─── HubSpot (reporte a Dani + reconciliación con Push 4) ─────────────────────
# Private App Token (PAT) de la cuenta del jefe. SOLO LECTURA — los scopes actuales
# NO incluyen ningún .write, así que Juanito puede LEER deals/contacts/companies/owners
# pero NO puede modificar HubSpot (no hay write-back de outcomes todavía). NO commitear.
# Scopes confirmados: crm.objects.{deals,contacts,companies,owners}.read +
#   crm.schemas.{deals,contacts,companies}.read + cms.{domains,pages}.read + files.
# OJO: NO trae leads.read (pipeline de leads pre-webinar no funciona) ni engagements
#   (meetings/calls pueden fallar → verificar con el probe de scopes).
HUBSPOT_PAT=                             # pega el token acá (Personal Access Key). NO commitear.
# HUBSPOT_ENABLED=false                  # gate maestro. Se autodesactiva si falta el PAT.
# HUBSPOT_PORTAL_ID=50929115             # cuenta "30x" (para los deep-links a deals). Default ya puesto.
#
# ── Modelo nudge (§18.AF): en vez de preguntarle el outcome al closer (Push 4), Juanito
#    revisa el deal en HubSpot y solo lo pica si sigue en "Agendado". APAGADO por default.
# HUBSPOT_NUDGE_ENABLED=false            # true = activa el nudge (requiere HUBSPOT_PAT)
#
# ── Cosecha por estado de agenda (§18.AG): la evolución del nudge. Lee el campo
#    `agenda_status` del deal (COMPLETED/NO_SHOW/RESCHEDULED/CANCELED/SCHEDULED) y DERIVA el
#    outcome directo a call_outcomes SIN preguntarle al closer (show/no-show/reagenda/cancel).
#    Solo lo pica si la call venció y sigue "Programada" sin cita futura. Da el no-show y la
#    reagenda, que la etapa del deal no distingue. APAGADO por default. Requiere programa
#    cubierto. Si está ON tiene prioridad sobre el nudge por etapa; ante duda cae a clásico.
# HUBSPOT_AGENDA_HARVEST=false           # true = cosecha outcomes desde agenda_status
# Programas cubiertos = los que tienen pipeline en ESTA cuenta. Default: los 3 confirmados.
# Formato: "programa:pipelineId" separados por coma. Los NO listados caen a Push 4 clásico.
#   developers → si Dani confirma que "AI for Developers" usa el pipeline "Hardcore AI",
#   agregar `developers:887379064`. abogados (EstadoX) vive en OTRO HubSpot → no cubrible aquí.
# HUBSPOT_PROGRAM_PIPELINES=second_brain:904247681,linkedin:906259304,operaciones:887379063
#
# ── Barrido periódico de cosecha (§18.AH): el harvest de arriba es UNA sola foto en el
#    momento del Push 4 (call_end + gracia). Si el closer actualiza el deal en HubSpot
#    DESPUÉS de esa foto, la fila ya cayó al nudge y cerró sola como 'no_answer' — sin que
#    nadie vuelva a mirar. Este job re-consulta HubSpot cada N horas para esas filas
#    abandonadas y recupera el outcome en silencio (nunca re-manda el nudge por WhatsApp).
#    ON por default en cuanto HUBSPOT_AGENDA_HARVEST=true (apagable aparte si hace falta).
# HUBSPOT_HARVEST_SWEEP_ENABLED=true      # false = harvest ON pero sin barrido de recuperación
# HUBSPOT_HARVEST_SWEEP_CRON=0 8-22/2 * * *   # cada 2h, 8am-10pm (horario donde hay actividad real)
# HUBSPOT_HARVEST_SWEEP_MAX_AGE_HOURS=72  # tope: pasado esto, la fila queda "sin registrar" definitivo
#
# Poll de las citas que SOLO viven en HubSpot (§18.AN). El closer/setter agenda dentro del CRM y
# esa cita nunca pasa por Calendly → medido, ~11 al día que salían en la agenda del jefe pero por
# las que NADIE avisaba al closer. Con esto reciben los mismos Push 0/3/4 que una cita de Calendly.
# Corre al final del poll de Calendly, en el mismo tick, para que una cita presente en las dos
# fuentes quede con UN solo push (el de Calendly manda).
# OFF por default: manda mensajes reales. Estrenarlo mirando primero qué HARÍA, dentro del
# contenedor:  runHubspotAgendaPoll({ preview: true })
# HUBSPOT_AGENDA_POLL=false
#
# Reagendas hechas DENTRO del CRM (§18.AO). Reagendar en HubSpot no mueve la cita: CREA una nueva
# y deja la vieja con su hora original, así que la vieja se queda con su Push 3 ("arranca en 25
# min") y su Push 4 ("¿cómo te fue?") para una llamada que no va a ocurrir. Medido: ~5 pushes
# rancios por semana. Este barrido los cancela, corriendo al final del poll (cada 5 min).
# ON por default, y NO depende de HUBSPOT_AGENDA_POLL: una cita que entró por Calendly también
# se puede mover dentro del CRM, y ese push rancio hay que cancelarlo igual. Interruptor propio
# porque su efecto es el opuesto al del poll —cancela avisos en vez de crearlos— y un falso
# positivo deja a un closer sin aviso de una call REAL.
# Preview:  runHubspotRescheduleScan({ preview: true })
# HUBSPOT_RESCHEDULE_SCAN=true
# HUBSPOT_RESCHEDULE_LOOKBACK_MIN=120     # cuánto atrás se miran las citas recién creadas

# ─── Dashboard de operación (docs/DASHBOARD-ROADMAP.md) ──────────────────────
# Contenedor `dash` en docker-compose. Read-only mientras DASH_WRITES esté vacío.

# Interfaz donde escucha el puerto del dashboard. Default LOOPBACK: se llega por
# `tailscale serve` (https://juanito.<tailnet>.ts.net), que proxea a 127.0.0.1:8080.
# Escape si Serve o los certs TLS fallan: poner la IP 100.x del nodo de Tailscale y
# entrar por http://<ip>:8080 — sigue siendo alcanzable solo desde el tailnet.
# NUNCA 0.0.0.0: eso sí expondría el puerto a internet.
DASH_BIND=127.0.0.1

# ¿El watchdog manda las alertas por WhatsApp, o solo las muestra en el dashboard?
# Arranca en false a propósito: el §18.AZ advierte que estas alertas compiten con el
# anti-ban y con la paciencia de quien las lee. Encender tras medir el volumen unos días.
# Los destinatarios son los ADMIN_LID. La salida usa la tabla `reminders` como outbox:
# el cron de recordatorios del bot las despacha por la cola anti-ban.
#
# ⚠️ En el VPS está en `true` desde el 2026-08-26 (§18.BN). El volumen que pedía medirse dio
# ~5 alertas/día con dedup de 6h. Mientras estuvo apagado, el watchdog detectó dos pushes
# muertos y escribió 5 alertas que nadie vio: un detector sin canal de salida es cero.
DASH_ALERTS_WHATSAPP=false

# Cada cuánto revisa el watchdog, y cuántas horas dedupe una alerta repetida.
DASH_WATCHDOG_MIN=15
DASH_ALERT_DEDUP_HOURS=6

# ── Escrituras del dashboard (F2) ────────────────────────────────────────────
# Qué tabs pueden ESCRIBIR. Vacío = solo lectura, el comportamiento de F1. Es el kill
# switch de la fase: se enciende un tab, se usa unos días, se enciende el siguiente.
# Tabs válidos: aprobaciones, grupos, programados, outreach, tareas, negocio,
# recordatorios, toggles. `todo` habilita los ocho.
# Cada acción llama a la MISMA función de src/db/index.js que el comando de WhatsApp
# equivalente, así que los dos lados no pueden divergir. Cambiar esto solo recrea el
# contenedor `dash` — el bot no se reinicia.
#   DASH_WRITES=aprobaciones,toggles
DASH_WRITES=

# Botón Deploy: PAT de GitHub con permiso `actions:write` sobre el repo. Es un secreto
# del CONTENEDOR (va en este .env del VPS), NO un Repository secret de GitHub — esos
# (VPS_HOST, VPS_PASSWORD) los usa el workflow, este lo usa el dashboard para
# dispararlo. Sin token, la ruta /api/deploy no existe y la UI no dibuja el botón.
# El repo (Agencia-Dani/Juanito) y la rama (main) tienen default en dashboard/server/deploy.js.
# ⚠️ El token ya NO alcanza por sí solo: disparar un deploy exige además `DASH_WRITES` no vacío.
# Con el dashboard en solo lectura, la escritura más grande que existe no puede ser la excepción.
DASH_GITHUB_TOKEN=

# Orígenes extra que pueden mandar POST al dashboard. Normalmente VACÍO: un pedido cuyo `Origin`
# coincide con el `Host` (o el `X-Forwarded-Host` que pone tailscale serve) ya pasa solo.
# Sirve para el dev server de Vite, que corre en otro puerto y por eso es otro origen.
# La defensa real contra CSRF no es esta lista sino el header `X-Dash-Origen` que exige
# dashboard/server/csrf.js — ahí está explicado por qué un header no estándar alcanza.
#   DASH_ALLOWED_ORIGINS=http://localhost:5173
DASH_ALLOWED_ORIGINS=

# Deadline de TODA llamada HTTP saliente (Calendly, HubSpot, Stripe, Sheets, GitHub), en ms.
# El `fetch` de Node no trae timeout: si el otro lado acepta la conexión y después se calla, la
# promesa queda colgada para siempre — y como los pollers hacen `await` en serie dentro del tick
# del cron, eso cuelga el JOB entero sin crashear el proceso. Contenedor "healthy", logs mudos,
# `entrypoint.sh` sin nada que reiniciar. Techo generoso a propósito: se corta el cuelgue
# infinito, no la lentitud (una página de 100 meetings de HubSpot tarda de verdad).
# Es por INTENTO, no por operación: los reintentos de 429 crean su propia señal.
HTTP_TIMEOUT_MS=30000

# ─── Runtime ──────────────────────────────────────────────────────────────────
TZ=America/Bogota
NODE_ENV=production
